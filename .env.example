# ── Public URLs (host-aware routing allowlist) ─────────────────────
# Current staged rollout: marketing live on operanto.ai, cockpit + API on the
# staging subdomains. When production cockpit is approved these become
# app.operanto.ai / api.operanto.ai.
# Local development: set all three to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=https://operanto.ai
NEXT_PUBLIC_APP_URL=https://staging.operanto.ai
NEXT_PUBLIC_API_URL=https://api-staging.operanto.ai

# ── Database (Neon; apply schema with `pnpm db:deploy` — never db push) ──
# Pooled connection for the app runtime:
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require
# Direct (non-pooled) connection for migrations — same URL without "-pooler":
DIRECT_URL=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DB?sslmode=require
# Local development alternative (docker-compose, host port 5435):
#   postgresql://operanto:operanto@localhost:5435/operanto_mvp for both.

# ── Auth.js ─────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32   (different per environment!)
AUTH_SECRET=
# The cockpit host — auth callbacks return here.
AUTH_URL=https://staging.operanto.ai
AUTH_TRUST_HOST=true

# ── Secrets encryption ──────────────────────────────────────────────
# 32-byte key, hex-encoded (64 chars). Generate: openssl rand -hex 32
# Used to encrypt integration webhook secrets at rest (AES-256-GCM).
OPERANTO_ENCRYPTION_KEY=

# ── Pronatona integration ───────────────────────────────────────────
# Shared HMAC secret — must equal OPERANTO_WEBHOOK_SECRET on the
# Pronatona side. Used only by the seed to provision the Integration row;
# afterwards the encrypted copy in the database is authoritative.
PRONATONA_WEBHOOK_SECRET=
# The Organisation.id of Pronatona inside the Pronatona database.
PRONATONA_SOURCE_ORGANISATION_ID=

# ── Privacy ─────────────────────────────────────────────────────────
# Days a raw inbound event payload is kept before the retention sweep
# redacts it to a non-personal envelope. Default 30.
OPERANTO_PAYLOAD_RETENTION_DAYS=30
# Days a conversation message body is kept before the retention sweep redacts
# it. Overridable per organisation (Organisation.messageRetentionDays).
# Default 365 — the PROVISIONAL 12-month value; the production policy still
# requires contractual and legal confirmation.
OPERANTO_MESSAGE_RETENTION_DAYS=365
# The deterministic conversation simulator is dev/test-only. It refuses to run
# with NODE_ENV=production unless this is set to 1 (staging opt-in only).
# OPERANTO_SIMULATOR_ENABLED=1

# ── AI assistance (Operanto Intelligence) ───────────────────────────
# AI is disabled per organisation by default and mock-mode by default.
# LIVE mode additionally requires this deployment-level opt-in — without it,
# every tenant runs the deterministic mock even if their row says LIVE.
# OPERANTO_AI_LIVE_ENABLED=1
# Provider key for live mode (deployment-level; per-tenant keys are out of
# scope — see docs/operanto-ai-handover.md).
# OPENAI_API_KEY=
# Fallback model when a tenant row has none. Documented default: gpt-4o-mini.
# OPERANTO_AI_DEFAULT_MODEL=gpt-4o-mini

# ── Test infrastructure (never honored in production) ───────────────
# Per-run rate-limit namespace for e2e/CI so repeated suites do not share
# counters with staging. Ignored entirely when NODE_ENV=production.
# OPERANTO_RATE_LIMIT_TEST_NAMESPACE=e2e-local

# ── Internal jobs ───────────────────────────────────────────────────
# Protects POST /api/internal/events/retry (failed-event retry sweep).
# Generate: openssl rand -hex 32
CRON_SECRET=

# ── Rate limiting (Upstash REST — the ONLY supported convention) ────
# Shared counters across instances. A bare REDIS_URL is deliberately not read
# by any code path: two conventions mean one is silently ignored.
# When these are set but Redis is unreachable, login and invitation limits
# FAIL CLOSED; event ingestion falls back to per-instance memory.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Email (invitation delivery) ─────────────────────────────────────
# When unset OUTSIDE production, invitation links are logged and shown to the
# inviting administrator. In production an unset provider reports the
# invitation as NOT delivered rather than logging a usable link.
RESEND_API_KEY=
# Sending subdomain, so the apex SPF and any future mailbox provider stay
# independent: EMAIL_FROM="Operanto <access@mail.operanto.ai>"
EMAIL_FROM=
# Optional: replies go to a monitored human rather than the sending subdomain.
EMAIL_REPLY_TO=

# ── Error reporting (optional — see docs/observability.md) ──────────
# Without SENTRY_DSN, errors are logged locally only. Payloads are scrubbed
# of secrets and PII before they ever leave the process.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Defaults to VERCEL_ENV/NODE_ENV and VERCEL_GIT_COMMIT_SHA respectively.
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=

# ── Seed (development / staging bootstrap only) ─────────────────────
SEED_ADMIN_EMAIL=
SEED_ADMIN_NAME=
SEED_ADMIN_PASSWORD=

# ── Acceptance-test fixtures (never set these in production) ─────────
# The seed refuses to create fixture accounts when NODE_ENV=production. Set
# SEED_TEST_USERS=1 to create them; each value below must be a throwaway
# credential generated for the environment, never a real or shared secret.
SEED_TEST_USERS=
SEED_TEST_ADMIN_PASSWORD=
SEED_TEST_OPERATOR_PASSWORD=
SEED_TEST_ISOLATION_ADMIN_PASSWORD=
# Base32 TOTP secret for the fixture admins. ADMIN and SUPERVISOR must have a
# second factor, so the acceptance suite needs to be able to compute a real
# code rather than bypassing the check. Generate with:
#   node -e "console.log(require('crypto').randomBytes(20).toString('base64').replace(/[^A-Z2-7]/g,'').slice(0,32))"
SEED_TEST_TOTP_SECRET=

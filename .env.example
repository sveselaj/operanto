# ── Public URLs (host-aware routing allowlist) ─────────────────────
# Current staged rollout: marketing live on operanto.ai, cockpit + API on the
# staging subdomains. When production cockpit is approved these become
# app.operanto.ai / api.operanto.ai.
# Local development: set all three to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=https://operanto.ai
NEXT_PUBLIC_APP_URL=https://staging.operanto.ai
NEXT_PUBLIC_API_URL=https://api-staging.operanto.ai

# ── Database (Neon; apply schema with `pnpm db:deploy` — never db push) ──
# Pooled connection for the app runtime:
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require
# Direct (non-pooled) connection for migrations — same URL without "-pooler":
DIRECT_URL=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DB?sslmode=require
# Local development alternative (docker-compose, host port 5435):
#   postgresql://operanto:operanto@localhost:5435/operanto_mvp for both.

# ── Auth.js ─────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32   (different per environment!)
AUTH_SECRET=
# The cockpit host — auth callbacks return here.
AUTH_URL=https://staging.operanto.ai
AUTH_TRUST_HOST=true

# ── Secrets encryption ──────────────────────────────────────────────
# 32-byte key, hex-encoded (64 chars). Generate: openssl rand -hex 32
# Used to encrypt integration webhook secrets at rest (AES-256-GCM).
OPERANTO_ENCRYPTION_KEY=

# ── Pronatona integration ───────────────────────────────────────────
# Shared HMAC secret — must equal OPERANTO_WEBHOOK_SECRET on the
# Pronatona side. Used only by the seed to provision the Integration row;
# afterwards the encrypted copy in the database is authoritative.
PRONATONA_WEBHOOK_SECRET=
# The Organisation.id of Pronatona inside the Pronatona database.
PRONATONA_SOURCE_ORGANISATION_ID=

# ── Internal jobs ───────────────────────────────────────────────────
# Protects POST /api/internal/events/retry (failed-event retry sweep).
# Generate: openssl rand -hex 32
CRON_SECRET=

# ── Rate limiting (optional) ────────────────────────────────────────
# Upstash Redis REST endpoint for shared rate limiting across instances.
# Falls back to per-instance in-memory limiting when unset.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Email (optional — invitation delivery) ──────────────────────────
# When unset, invitation links are printed to the server log instead.
RESEND_API_KEY=
EMAIL_FROM=

# ── Error reporting (optional) ──────────────────────────────────────
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# ── Seed (development / staging bootstrap only) ─────────────────────
SEED_ADMIN_EMAIL=
SEED_ADMIN_NAME=
SEED_ADMIN_PASSWORD=

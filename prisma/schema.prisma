// Operanto — multi-tenant operational cockpit.
//
// Tenancy: every tenant-scoped row carries `organisationId` and is indexed on
// it. Cross-tenant isolation is enforced at the data-access layer: no query
// touches tenant data without a resolved, active membership (see
// src/lib/org-context.ts). Source-system records are projections — Pronatona
// remains the system of record for properties, leads, and staff membership;
// Operanto stores operational projections and orchestration state, linked back
// through explicit external-identity mappings.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Non-pooled connection for migrations (Neon: host without "-pooler").
  directUrl = env("DIRECT_URL")
}

// ── Identity & tenancy ─────────────────────────────────────────────

enum OrganisationStatus {
  ACTIVE
  SUSPENDED
}

enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

enum MembershipRole {
  ADMIN
  SUPERVISOR
  OPERATOR
  /// Organisation-wide read-only compliance access (OI-3; approved OI-1 §11).
  /// Holds view permissions only — assertive writes are structurally denied
  /// by the permission matrix. Requires 2FA like the other privileged roles.
  AUDITOR
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

model Organisation {
  id        String             @id @default(cuid())
  name      String
  slug      String             @unique
  status    OrganisationStatus @default(ACTIVE)
  vertical  String             @default("real_estate")
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  /// Days conversation message bodies are kept before the retention sweep
  /// redacts them. Null = the platform default (12 months, provisional —
  /// the production value requires contractual and legal confirmation, see
  /// docs/operanto-conversations-foundation.md). Erasure and restriction
  /// always take precedence over retention.
  messageRetentionDays Int?

  memberships      Membership[]
  invitations      Invitation[]
  integrations     Integration[]
  identityMappings ExternalIdentityMapping[]
  inboundEvents    InboundEvent[]
  customers        Customer[]
  opportunities    Opportunity[]
  propertyContexts PropertyContext[]
  activities       Activity[]
  tasks            Task[]
  auditEvents      AuditEvent[]
  channelConnections       ChannelConnection[]
  conversations            Conversation[]
  conversationParticipants ConversationParticipant[]
  messages                 Message[]
  conversationNotes        ConversationNote[]
  customerIdentities       CustomerIdentity[]
  aiActions                AIAction[]
  approvalRequests         ApprovalRequest[]
  aiConfiguration          AiConfiguration?
  channelInboundEvents     ChannelInboundEvent[]
  consents                 Consent[]
  messageTemplates         MessageTemplate[]
  targetProfiles           TargetProfile[]
  growthAccounts           GrowthAccount[]
  growthContacts           GrowthContact[]
  accountSourceRecords     AccountSourceRecord[]
  researchRuns             ResearchRun[]
  researchEvidence         ResearchEvidence[]
  accountScores            AccountScore[]
  accountBriefs            AccountBrief[]
  outreachPlaybooks        OutreachPlaybook[]
  outreachDrafts           OutreachDraft[]
  outreachDraftVersions    OutreachDraftVersion[]
  suppressionEntries       SuppressionEntry[]
  growthImports            GrowthImport[]
  leads                    Lead[]
  leadStatusHistories      LeadStatusHistory[]
  telephonyConnections     TelephonyConnection[]
}

model User {
  id                String     @id @default(cuid())
  name              String
  email             String     @unique
  passwordHash      String?
  status            UserStatus @default(INVITED)
  passwordUpdatedAt DateTime?
  sessionsRevokedAt DateTime?

  /// TOTP secret, encrypted at rest with OPERANTO_ENCRYPTION_KEY. Present
  /// only while enrolment is in progress or 2FA is active.
  totpSecretEncrypted String?
  /// Set when the user has proved they can generate a valid code. Until then
  /// enrolment is incomplete and 2FA is not enforced for them.
  totpConfirmedAt     DateTime?
  /// Single-use recovery codes, stored as SHA-256 hashes. Consumed on use.
  recoveryCodeHashes  String[]  @default([])
  /// Highest TOTP counter already accepted. Without it a code stays usable
  /// for its whole ~90 s window and an observed code can be replayed.
  totpLastCounter     BigInt?
  /// Candidate secret during a ROTATION (lost or compromised authenticator).
  /// Held separately so the ACTIVE secret keeps working until the new one is
  /// proved — a rotation must never leave a privileged account locked out or
  /// unprotected mid-flight.
  totpPendingSecretEncrypted String?
  lastLoginAt       DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  memberships Membership[]
}

model Membership {
  id             String           @id @default(cuid())
  userId         String
  organisationId String
  role           MembershipRole   @default(OPERATOR)
  status         MembershipStatus @default(INVITED)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  assignedOpportunities Opportunity[] @relation("OpportunityAssignee")
  assignedTasks         Task[]        @relation("TaskAssignee")
  createdTasks          Task[]        @relation("TaskCreator")
  assignedConversations Conversation[] @relation("ConversationAssignee")
  createdConversations  Conversation[] @relation("ConversationCreator")
  sentMessages          Message[]      @relation("MessageSender")
  conversationNotes     ConversationNote[]        @relation("NoteAuthor")
  conversationPresences ConversationParticipant[] @relation("ParticipantMembership")
  handlingChanges       Conversation[]            @relation("HandlingChanger")
  requestedAiActions    AIAction[]                @relation("AIActionRequester")
  requestedApprovals    ApprovalRequest[]         @relation("ApprovalRequester")
  reviewingApprovals    ApprovalRequest[]         @relation("ApprovalReviewer")
  decidedApprovals      ApprovalRequest[]         @relation("ApprovalDecider")
  consentUpdates        Consent[]                 @relation("ConsentUpdater")
  assignedLeads         Lead[]                    @relation("LeadAssignee")
  createdLeads          Lead[]                    @relation("LeadCreator")
  leadStatusChanges     LeadStatusHistory[]       @relation("LeadStatusChanger")

  @@unique([organisationId, userId])
  @@index([userId])
}

model Invitation {
  id              String         @id @default(cuid())
  organisationId  String
  email           String
  role            MembershipRole @default(OPERATOR)
  tokenHash       String         @unique
  invitedByUserId String?
  expiresAt       DateTime
  acceptedAt      DateTime?
  createdAt       DateTime       @default(now())

  /// Delivery state is tracked separately from creation: an invitation whose
  /// email failed to send must never look delivered, or an administrator will
  /// wait for a message that never arrives.
  deliveredAt      DateTime?
  deliveryAttempts Int       @default(0)
  lastDeliveryError String?
  /// Superseded by a newer invitation for the same address, or withdrawn.
  /// A revoked invitation can never be accepted, even before it expires.
  revokedAt        DateTime?

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@index([organisationId, email])
}

// ── Integrations & event ingestion ─────────────────────────────────

enum IntegrationType {
  PRONATONA
}

enum IntegrationStatus {
  ACTIVE
  DISABLED
}

model Integration {
  id                     String            @id @default(cuid())
  organisationId         String
  type                   IntegrationType
  sourceSystem           String // e.g. "PRONATONA_WEB"
  sourceOrganisationId   String // the organisation id inside the source system
  status                 IntegrationStatus @default(ACTIVE)
  // AES-256-GCM ciphertext of the shared webhook secret (see src/lib/crypto.ts).
  // A hash would not suffice: HMAC verification needs the plaintext secret.
  webhookSecretEncrypted String
  lastReceivedAt         DateTime?
  lastSuccessfulAt       DateTime?
  lastErrorAt            DateTime?
  lastError              String?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  organisation  Organisation   @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  inboundEvents InboundEvent[]

  @@unique([type, sourceOrganisationId])
  @@index([organisationId])
}

model ExternalIdentityMapping {
  id                 String   @id @default(cuid())
  organisationId     String
  sourceSystem       String
  sourceEntityType   String // "lead" | "property" | "customer" | "staff" | "organisation" | ...
  sourceEntityId     String
  operantoEntityType String // "opportunity" | "property_context" | "customer" | "membership" | ...
  operantoEntityId   String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@unique([organisationId, sourceSystem, sourceEntityType, sourceEntityId])
  @@index([organisationId, operantoEntityType, operantoEntityId])
}

enum EventProcessingStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  FAILED
  DEAD_LETTER
}

model InboundEvent {
  id                   String                @id @default(cuid())
  organisationId       String
  integrationId        String
  eventId              String // source event id — idempotency key per integration
  eventType            String
  schemaVersion        Int                   @default(1)
  sourceSystem         String
  sourceOrganisationId String
  occurredAt           DateTime
  receivedAt           DateTime              @default(now())
  correlationId        String?
  /// The event exactly as received. It contains the customer's name, email,
  /// phone and free text, so it is redacted once it is no longer needed for
  /// replay or debugging — see payloadRedactedAt and the retention sweep.
  rawPayload           Json
  /// Set when rawPayload was replaced by a minimal, non-personal skeleton,
  /// either by the retention sweep or by an erasure request.
  payloadRedactedAt    DateTime?
  processingStatus     EventProcessingStatus @default(RECEIVED)
  attemptCount         Int                   @default(0)
  lastError            String?
  processedAt          DateTime?

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  integration  Integration  @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@unique([integrationId, eventId])
  @@index([organisationId, processingStatus])
  @@index([organisationId, receivedAt])
  @@index([organisationId, eventType])
  // Created by 20260731140000_privacy_lifecycle for the retention sweep;
  // declared here so schema and migration history agree.
  @@index([payloadRedactedAt, receivedAt])
}

// ── Operational projections ────────────────────────────────────────

model Customer {
  id                 String    @id @default(cuid())
  organisationId     String
  sourceSystem       String?
  sourceCustomerId   String?
  name               String?
  email              String?
  emailNormalized    String? // lowercased/trimmed — matching key, never merged fuzzily
  phone              String?
  phoneNormalized    String? // digits with leading + — matching key
  preferredLanguage  String?
  preferredChannel   String?
  matchReason        String? // why the latest inbound identity resolved to this row
  /// Personal data erased on request (GDPR Art. 17). The row survives as a
  /// tombstone so opportunities, timeline and audit stay referentially intact
  /// and the erasure itself remains provable.
  erasedAt           DateTime?
  /// Processing restricted (GDPR Art. 18): data is retained but must not be
  /// used. Inbound events for this customer are stored and then held.
  restrictedAt       DateTime?
  firstInteractionAt DateTime?
  lastInteractionAt  DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  organisation  Organisation  @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  opportunities Opportunity[]
  activities    Activity[]
  conversations Conversation[]
  participations ConversationParticipant[]
  channelIdentities CustomerIdentity[]
  aiActions     AIAction[]
  consents      Consent[]
  leads         Lead[]

  @@unique([organisationId, sourceSystem, sourceCustomerId])
  @@index([organisationId, emailNormalized])
  @@index([organisationId, phoneNormalized])
  @@index([organisationId, lastInteractionAt])
  // Created by 20260731140000_privacy_lifecycle for the erasure/restriction
  // views; declared here so schema and migration history agree.
  @@index([organisationId, erasedAt])
}

enum OpportunityStage {
  NEW
  CONTACT_REQUIRED
  QUALIFYING
  VIEWING_REQUESTED
  VIEWING_SCHEDULED
  OFFER
  WON
  LOST
  CLOSED
}

model Opportunity {
  id                   String           @id @default(cuid())
  organisationId       String
  sourceSystem         String?
  sourceOpportunityId  String? // e.g. the Pronatona lead id
  customerId           String
  type                 String // PROPERTY_QUESTION | VIEWING_REQUEST | SELL_PROPERTY | GENERAL_INQUIRY
  stage                OpportunityStage @default(NEW)
  sourceStage          String? // the authoritative Pronatona lead status, preserved verbatim
  assignedMembershipId String?
  sourceChannel        String?
  summary              String?
  inquiryText          String?
  preferredDate        DateTime?
  lastActivityAt       DateTime?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  customer     Customer     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  assignee     Membership?  @relation("OpportunityAssignee", fields: [assignedMembershipId], references: [id], onDelete: SetNull)

  properties OpportunityProperty[]
  activities Activity[]
  tasks      Task[]

  @@unique([organisationId, sourceSystem, sourceOpportunityId])
  @@index([organisationId, stage])
  @@index([organisationId, assignedMembershipId])
  @@index([organisationId, lastActivityAt])
  @@index([customerId])
}

model PropertyContext {
  id               String   @id @default(cuid())
  organisationId   String
  sourceSystem     String
  sourcePropertyId String
  referenceCode    String?
  title            String?
  status           String? // source status verbatim (ACTIVE / RESERVED / SOLD / ...)
  price            Decimal? @db.Decimal(12, 2)
  currency         String?
  city             String?
  thumbnailUrl     String?
  sourceUrl        String? // canonical URL back into Pronatona
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  organisation  Organisation          @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  opportunities OpportunityProperty[]

  @@unique([organisationId, sourceSystem, sourcePropertyId])
  @@index([organisationId, referenceCode])
}

model OpportunityProperty {
  opportunityId     String
  propertyContextId String

  opportunity     Opportunity     @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  propertyContext PropertyContext @relation(fields: [propertyContextId], references: [id], onDelete: Cascade)

  @@id([opportunityId, propertyContextId])
}

// ── Timeline, tasks, audit ─────────────────────────────────────────

enum ActorType {
  CUSTOMER
  STAFF
  SYSTEM
  INTEGRATION
}

model Activity {
  id                String    @id @default(cuid())
  organisationId    String
  customerId        String?
  opportunityId     String?
  conversationId    String?
  /// Growth prospecting: account-level timeline events (G2, additive).
  growthAccountId   String?
  /// CRM module: lead-level timeline events (OI-3, additive).
  leadId            String?
  actorType         ActorType
  actorUserId       String?
  actorMembershipId String?
  activityType      String // inquiry.received | customer.created | customer.matched | opportunity.created | ...
  sourceSystem      String?
  summary           String
  metadata          Json?
  occurredAt        DateTime  @default(now())
  createdAt         DateTime  @default(now())

  organisation Organisation  @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  customer     Customer?     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  opportunity  Opportunity?  @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  growthAccount GrowthAccount? @relation(fields: [growthAccountId], references: [id], onDelete: Cascade)
  lead          Lead?          @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([organisationId, occurredAt])
  @@index([opportunityId, occurredAt])
  @@index([customerId, occurredAt])
  @@index([conversationId, occurredAt])
  @@index([leadId, occurredAt])
}

enum TaskStatus {
  OPEN
  COMPLETED
  /// OI-3 (additive, per the target architecture's "richer status values
  /// appended"): auto-cancelled work — e.g. open lead tasks when the lead
  /// reaches a terminal status. Distinct from COMPLETED: nobody did it.
  CANCELLED
}

enum TaskPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

model Task {
  id                    String       @id @default(cuid())
  organisationId        String
  opportunityId         String?
  /// Growth prospecting: tasks raised from account review (G1, additive).
  growthAccountId       String?
  /// Set when the task was raised from a conversation, so the work stays
  /// visible in that conversation's timeline and the customer's context.
  conversationId        String?
  /// CRM module: lead follow-up work, incl. THE open callback task (OI-3).
  leadId                String?
  /// Task type within its module, string-typed like Activity.activityType
  /// (CRM uses the crm-domain TaskType vocabulary, e.g. "CALLBACK"). Null for
  /// pre-OI-3 tasks and generic follow-ups.
  type                  String?
  assignedMembershipId  String?
  createdByMembershipId String?
  title                 String
  description           String?
  status                TaskStatus   @default(OPEN)
  priority              TaskPriority @default(NORMAL)
  dueAt                 DateTime?
  completedAt           DateTime?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  organisation Organisation  @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  opportunity  Opportunity?  @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  growthAccount GrowthAccount? @relation(fields: [growthAccountId], references: [id], onDelete: Cascade)
  lead         Lead?         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  assignee     Membership?   @relation("TaskAssignee", fields: [assignedMembershipId], references: [id], onDelete: SetNull)
  createdBy    Membership?   @relation("TaskCreator", fields: [createdByMembershipId], references: [id], onDelete: SetNull)

  @@index([organisationId, status, dueAt])
  @@index([organisationId, assignedMembershipId])
  @@index([opportunityId])
  @@index([conversationId])
  @@index([leadId])
}

// ── Conversations foundation ───────────────────────────────────────
//
// Slice 1 of the consolidation plan (docs/operanto-target-architecture.md):
// organisation-scoped conversations with manual entry and a deterministic
// simulator channel. Live provider channels, AI assistance, and attachments
// are explicitly deferred — see docs/operanto-conversations-foundation.md.

enum ChannelType {
  MANUAL
  SIMULATOR
  WHATSAPP
}

enum ChannelConnectionStatus {
  ACTIVE
  DISABLED
}

enum ConversationStatus {
  OPEN
  PENDING
  RESOLVED
  ARCHIVED
}

enum ConversationPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum ConversationParticipantType {
  CUSTOMER
  STAFF
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageSenderType {
  CUSTOMER
  STAFF
  SYSTEM
}

/// Delivery lifecycle foundation. RECORDED is the explicit LOCAL/UNSENT
/// state: the message exists only inside Operanto and nothing has been
/// transmitted anywhere — including messages created by approving an AI
/// draft. INVARIANT for future channel workers: a RECORDED message must
/// NEVER be sent automatically; sending is a separate, explicit operation
/// that re-checks permission, conversation access, restriction, consent,
/// messaging window, template requirements, provider connection,
/// idempotency, and the current approval state (Slice 5).
enum MessageDeliveryStatus {
  RECORDED
  QUEUED
  SENDING
  SENT
  DELIVERED
  READ
  FAILED
}

model ChannelConnection {
  id             String                  @id @default(cuid())
  organisationId String
  type           ChannelType
  displayName    String
  status         ChannelConnectionStatus @default(ACTIVE)
  /// Connection health, stamped by the ingestion pipeline.
  lastReceivedAt   DateTime?
  lastSuccessfulAt DateTime?
  lastErrorAt      DateTime?
  lastError        String?

  /// WhatsApp Cloud (Slice 5B): each organisation connects its OWN WhatsApp
  /// Business Account and phone number under the one Operanto-managed Meta
  /// application. phoneNumberId is the AUTHORITATIVE tenant-routing key for
  /// inbound webhooks — globally unique in Meta's namespace, enforced unique
  /// here so routing can never be ambiguous. The access token is AES-256-GCM
  /// ciphertext under OPERANTO_ENCRYPTION_KEY; no plaintext credential is
  /// ever stored.
  wabaId               String?
  phoneNumberId        String?
  displayPhoneNumber   String?
  accessTokenEncrypted String?
  tokenExpiresAt       DateTime?
  lastVerifiedAt       DateTime?
  /// Per-connection stage gates; both default OFF. Deployment-level flags
  /// (OPERANTO_WHATSAPP_INBOUND_ENABLED / _OUTBOUND_ENABLED) gate on top.
  inboundEnabled       Boolean   @default(false)
  outboundEnabled      Boolean   @default(false)

  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  organisation  Organisation   @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  conversations Conversation[]
  messages      Message[]
  inboundEvents ChannelInboundEvent[]

  @@unique([organisationId, type, displayName])
  @@unique([type, phoneNumberId])
  @@index([organisationId])
}

enum ChannelEventStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  IGNORED
  FAILED
  DEAD_LETTER
}

/// Raw channel webhook/simulator payloads — the store-then-process pipeline
/// for conversation channels, mirroring InboundEvent: persist raw with a
/// tenant-safe idempotency constraint, acknowledge, process asynchronously
/// with an atomic claim, bounded retries, and a dead-letter state. Payloads
/// hold customer text, so they follow the same retention redaction as
/// InboundEvent.rawPayload and are redacted on erasure via conversationId.
model ChannelInboundEvent {
  id                  String             @id @default(cuid())
  organisationId      String
  channelConnectionId String
  /// "message" | "status" — what the adapter classified the payload as.
  eventKind           String
  /// Provider-derived idempotency key; unique per connection (connections
  /// are organisation-owned, so this is tenant-scoped by construction).
  dedupeKey           String
  rawPayload          Json
  payloadRedactedAt   DateTime?
  status              ChannelEventStatus @default(RECEIVED)
  attemptCount        Int                @default(0)
  lastError           String?
  /// Set during processing — the erasure anchor for payload redaction.
  conversationId      String?
  receivedAt          DateTime           @default(now())
  processedAt         DateTime?

  organisation Organisation      @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  connection   ChannelConnection @relation(fields: [channelConnectionId], references: [id], onDelete: Cascade)
  conversation Conversation?     @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@unique([channelConnectionId, dedupeKey])
  @@index([organisationId, status, receivedAt])
  @@index([organisationId, conversationId])
}

enum ConsentStatus {
  UNKNOWN
  OPTED_IN
  OPTED_OUT
}

/// Per-customer, per-channel consent state — the policy foundation every
/// future outbound send must check. Rows are compliance evidence: they are
/// kept through erasure (they carry no personal data beyond the tombstoned
/// customer reference) and never removed by retention.
model Consent {
  id                    String        @id @default(cuid())
  organisationId        String
  customerId            String
  channelType           ChannelType
  status                ConsentStatus @default(UNKNOWN)
  /// Provenance: "inbound_keyword" | "manual" — how this state was set.
  source                String
  updatedByMembershipId String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  customer     Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  updatedBy    Membership?  @relation("ConsentUpdater", fields: [updatedByMembershipId], references: [id], onDelete: SetNull)

  @@unique([organisationId, customerId, channelType])
  @@index([organisationId, customerId])
}

enum ConversationHandling {
  AI_ASSISTED
  HUMAN_CONTROLLED
}

model Conversation {
  id                    String               @id @default(cuid())
  organisationId        String
  /// Who is steering this conversation. AI never acts autonomously in either
  /// state — HUMAN_CONTROLLED additionally documents that a person has taken
  /// explicit ownership and AI runs only on direct request.
  handling                      ConversationHandling @default(AI_ASSISTED)
  handlingChangedByMembershipId String?
  handlingChangedAt             DateTime?
  /// Null while the counterpart is not linked to a Customer record; the
  /// CUSTOMER participant row then carries their display identity.
  customerId            String?
  channelConnectionId   String?
  channelType           ChannelType          @default(MANUAL)
  /// Thread id inside the source channel (simulator scenarios set one so
  /// re-runs are idempotent; live channels will use provider thread ids).
  providerThreadId      String?
  subject               String?
  status                ConversationStatus   @default(OPEN)
  priority              ConversationPriority @default(NORMAL)
  assignedMembershipId  String?
  createdByMembershipId String?
  lastMessageAt         DateTime?
  lastInboundAt         DateTime?
  lastOutboundAt        DateTime?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  organisation Organisation       @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  customer     Customer?          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  connection   ChannelConnection? @relation(fields: [channelConnectionId], references: [id], onDelete: Restrict)
  assignee     Membership?        @relation("ConversationAssignee", fields: [assignedMembershipId], references: [id], onDelete: SetNull)
  createdBy    Membership?        @relation("ConversationCreator", fields: [createdByMembershipId], references: [id], onDelete: SetNull)
  handlingChangedBy Membership?   @relation("HandlingChanger", fields: [handlingChangedByMembershipId], references: [id], onDelete: SetNull)

  participants ConversationParticipant[]
  messages     Message[]
  notes        ConversationNote[]
  activities   Activity[]
  tasks        Task[]
  aiActions    AIAction[]
  approvalRequests ApprovalRequest[]
  channelInboundEvents ChannelInboundEvent[]

  @@unique([organisationId, channelConnectionId, providerThreadId])
  @@index([organisationId, lastMessageAt])
  @@index([organisationId, status, lastMessageAt])
  @@index([organisationId, assignedMembershipId])
  @@index([organisationId, customerId])
}

model ConversationParticipant {
  id             String                      @id @default(cuid())
  organisationId String
  conversationId String
  type           ConversationParticipantType
  /// Set when the participant is a linked Customer record.
  customerId     String?
  /// Set when the participant is a staff member (first message creates it).
  membershipId   String?
  /// Display identity for counterparts that are not (yet) linked to a
  /// Customer. Redacted on erasure of the linked customer.
  displayName    String?
  /// Sender reference inside the source channel (e.g. a simulator handle).
  externalRef    String?
  createdAt      DateTime                    @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  customer     Customer?    @relation(fields: [customerId], references: [id], onDelete: Restrict)
  membership   Membership?  @relation("ParticipantMembership", fields: [membershipId], references: [id], onDelete: SetNull)

  @@unique([organisationId, conversationId, customerId])
  @@unique([organisationId, conversationId, membershipId])
  @@index([conversationId])
  @@index([organisationId, customerId])
}

model Message {
  id                  String                @id @default(cuid())
  organisationId      String
  conversationId      String
  channelConnectionId String?
  direction           MessageDirection
  senderType          MessageSenderType
  senderMembershipId  String?
  body                String
  /// Message id inside the source channel — the dedupe key. Enforced by a
  /// tenancy-scoped unique constraint, never by read-then-write.
  providerMessageId   String?
  providerTimestamp   DateTime?
  deliveryStatus      MessageDeliveryStatus @default(RECORDED)
  /// Stamped by the delivery state machine on every accepted transition.
  statusUpdatedAt     DateTime?
  /// Provider failure detail when deliveryStatus is FAILED.
  errorMessage        String?
  metadata            Json?
  /// Explicit-send idempotency: unique per organisation, set only by the
  /// outbound send operation before any provider call.
  clientDedupeKey     String?
  /// Set when the body was replaced by the retention sweep or an erasure.
  redactedAt          DateTime?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  organisation Organisation       @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  conversation Conversation       @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  connection   ChannelConnection? @relation(fields: [channelConnectionId], references: [id], onDelete: Restrict)
  sender       Membership?        @relation("MessageSender", fields: [senderMembershipId], references: [id], onDelete: SetNull)

  @@unique([organisationId, channelConnectionId, providerMessageId])
  @@unique([organisationId, clientDedupeKey])
  @@index([conversationId, createdAt])
  @@index([organisationId, redactedAt, createdAt])
}

/// A customer's identity inside one channel — the exact-match rung that lets
/// channel ingestion recognise a returning sender. Written when staff link a
/// conversation whose counterpart carries a channel reference (the link
/// "teaches" the identity), consumed by ingestion before any e-mail matching.
/// Exact match only, never fuzzy — consistent with the events identity ladder
/// (docs/customer-matching.md). Deleted, not redacted, on erasure: the row is
/// a pure identifier, and keeping it would re-match the tombstone.
model CustomerIdentity {
  id             String      @id @default(cuid())
  organisationId String
  customerId     String
  channelType    ChannelType
  /// Sender reference inside the channel (a simulator handle today, a
  /// provider sender id for live channels later).
  externalId     String
  displayHandle  String?
  /// Provenance: how this identity was established (e.g. "manual_link").
  source         String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  customer     Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([organisationId, channelType, externalId])
  @@index([organisationId, customerId])
}

enum TemplateStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Organisation-authorized WhatsApp message templates. Outside the 24-hour
/// customer-service window a send MUST reference an APPROVED row from this
/// table — never an arbitrary client-provided template name. Rows mirror
/// templates approved in Meta Business Manager (no automatic sync in this
/// slice; administration is manual and audited).
model MessageTemplate {
  id             String         @id @default(cuid())
  organisationId String
  name           String
  language       String
  /// Human-readable body for preview only; contains no customer data.
  body           String
  status         TemplateStatus @default(PENDING)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@unique([organisationId, name, language])
  @@index([organisationId, status])
}

/// Internal staff commentary. Deliberately a separate model from Message so
/// a future outbound channel adapter cannot ship a note to a customer by
/// mishandling a direction flag.
model ConversationNote {
  id                 String   @id @default(cuid())
  organisationId     String
  conversationId     String
  authorMembershipId String?
  body               String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  author       Membership?  @relation("NoteAuthor", fields: [authorMembershipId], references: [id], onDelete: SetNull)

  @@index([conversationId, createdAt])
}

// ── AI handover (Operanto Intelligence, Slice 4) ───────────────────
//
// AI is advisory: every output is a suggestion until a human approves it,
// and nothing here can send externally or mutate business records directly.
// See docs/operanto-ai-handover.md.

enum AITaskType {
  SUMMARY
  CLASSIFICATION
  REPLY_DRAFT
  NEXT_ACTION
}

enum AIActionStatus {
  PENDING
  COMPLETED
  FAILED
  REJECTED
  APPROVED
  SUPERSEDED
}

enum AIRiskLevel {
  LOW
  MEDIUM
  HIGH
  BLOCKED
}

enum AIMode {
  MOCK
  LIVE
}

enum ApprovalSourceType {
  AI_REPLY_DRAFT
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  EXPIRED
}

/// One AI invocation and its outcome. The full conversation content used to
/// build the prompt lives only in request memory — what is persisted is the
/// validated structured OUTPUT (which erasure and retention redact via
/// redactedAt) plus a PII-reduced input descriptor: counts and flags, never
/// message bodies or names.
model AIAction {
  id                      String         @id @default(cuid())
  organisationId          String
  conversationId          String?
  customerId              String?
  requestedByMembershipId String?
  provider                String
  model                   String
  taskType                AITaskType
  promptVersion           String
  status                  AIActionStatus @default(PENDING)
  confidence              Float?
  riskLevel               AIRiskLevel?
  inputSummary            Json?
  outputJson              Json?
  usageJson               Json?
  providerRequestId       String?
  errorCode               String?
  /// Set when outputJson/inputSummary were redacted by erasure or retention.
  redactedAt              DateTime?
  createdAt               DateTime       @default(now())
  completedAt             DateTime?

  organisation Organisation  @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  customer     Customer?     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  requestedBy  Membership?   @relation("AIActionRequester", fields: [requestedByMembershipId], references: [id], onDelete: SetNull)

  @@index([organisationId, conversationId, createdAt])
  @@index([organisationId, createdAt])
  @@index([organisationId, redactedAt, createdAt])
}

/// One human decision gate. Slice 4 uses it for AI reply drafts; later
/// slices reuse the same model for business actions. Approval here means
/// "may be recorded as a manual Operanto message" — never an external send.
model ApprovalRequest {
  id                           String             @id @default(cuid())
  organisationId               String
  conversationId               String?
  sourceType                   ApprovalSourceType
  /// Id of the source record (the AIAction for AI_REPLY_DRAFT).
  sourceId                     String
  actionType                   String
  status                       ApprovalStatus     @default(PENDING)
  requestedByMembershipId      String?
  assignedReviewerMembershipId String?
  decidedByMembershipId        String?
  /// Draft content as produced (and as edited). Customer-derived text lives
  /// here and NOWHERE in audit metadata; erasure/retention redact via
  /// redactedAt.
  originalPayload              Json
  editedPayload                Json?
  decisionReason               String?
  /// Confidence/risk snapshot, so decision policy is enforced server-side
  /// against what was reviewed, not against a mutable source record.
  riskLevel                    AIRiskLevel
  lowConfidence                Boolean            @default(false)
  idempotencyKey               String
  requestedAt                  DateTime           @default(now())
  decidedAt                    DateTime?
  expiresAt                    DateTime?
  executionClaimedAt           DateTime?
  redactedAt                   DateTime?

  organisation Organisation  @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  requestedBy  Membership?   @relation("ApprovalRequester", fields: [requestedByMembershipId], references: [id], onDelete: SetNull)
  assignedReviewer Membership? @relation("ApprovalReviewer", fields: [assignedReviewerMembershipId], references: [id], onDelete: SetNull)
  decidedBy    Membership?   @relation("ApprovalDecider", fields: [decidedByMembershipId], references: [id], onDelete: SetNull)

  @@unique([organisationId, idempotencyKey])
  @@unique([organisationId, sourceType, sourceId])
  @@index([organisationId, status, requestedAt])
  @@index([conversationId])
}

/// Per-organisation AI configuration and usage accounting. AI is DISABLED by
/// default and mock-mode by default — live provider calls require both the
/// enabled flag and an explicit LIVE mode, set by an administrator and
/// audited. Budget counters are enforced with atomic conditional updates.
model AiConfiguration {
  id                       String       @id @default(cuid())
  organisationId           String       @unique
  enabled                  Boolean      @default(false)
  mode                     AIMode       @default(MOCK)
  provider                 String       @default("openai")
  /// Default documented in docs/operanto-ai-handover.md; replaceable per
  /// tenant and via OPERANTO_AI_DEFAULT_MODEL. Never hard-coded in services.
  model                    String       @default("gpt-4o-mini")
  monthlyRequestLimit      Int          @default(200)
  monthlyTokenLimit        Int?
  monthlyCostLimitCents    Int?
  periodStart              DateTime     @default(now())
  periodRequestCount       Int          @default(0)
  periodTokenCount         Int          @default(0)
  periodEstimatedCostCents Int          @default(0)
  permittedTaskTypes       AITaskType[] @default([SUMMARY, CLASSIFICATION, REPLY_DRAFT, NEXT_ACTION])
  confidencePolicyVersion  String       @default("v1")
  /// Audit-only scalar (who last changed configuration); the full change is
  /// in AuditEvent.
  updatedByMembershipId    String?
  createdAt                DateTime     @default(now())
  updatedAt                DateTime     @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
}

model AuditEvent {
  id                String    @id @default(cuid())
  organisationId    String
  actorType         ActorType
  actorUserId       String?
  actorMembershipId String?
  targetType        String
  targetId          String?
  eventType         String // auth.login | member.invited | opportunity.stage_changed | event.processed | ...
  beforeMetadata    Json?
  afterMetadata     Json?
  correlationId     String?
  requestId         String?
  occurredAt        DateTime  @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@index([organisationId, occurredAt])
  @@index([organisationId, targetType, targetId])
  @@index([organisationId, correlationId])
}


// ── Operanto Growth Prospecting Program (G1 foundation) ─────────────
// Account Intelligence and Assisted Outreach. Release 1 contains NO
// sending capability of any kind: drafts end at APPROVED/MANUALLY_SENT
// (a human copies the message out and records the fact). Prospect
// personal data joins the privacy lifecycle from the first row.

enum TargetProfileStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

enum GrowthAccountStatus {
  IMPORTED
  NEEDS_REVIEW
  READY_FOR_RESEARCH
  RESEARCHING
  READY_FOR_ASSESSMENT
  APPROVED
  REJECTED
  DRAFT_PREPARED
  CONTACTED
  REPLIED
  QUALIFIED
  MEETING_BOOKED
  NOT_NOW
  SUPPRESSED
  CUSTOMER
}

enum EvidenceClassification {
  VERIFIED_FACT
  INFERENCE
  HYPOTHESIS
}

enum ResearchRunStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum GrowthDraftStatus {
  DRAFT
  AWAITING_REVIEW
  APPROVED
  REJECTED
  MANUALLY_SENT
  CANCELLED
}

/// What kinds of companies the team wants to reach, and how to score them.
model TargetProfile {
  id                 String              @id @default(cuid())
  organisationId     String
  name               String
  description        String?
  industries         String[]
  regions            String[]
  companySizeMin     Int?
  companySizeMax     Int?
  characteristics    String[]
  decisionMakerRoles String[]
  positiveSignals    String[]
  negativeSignals    String[]
  exclusionCriteria  String[]
  operantoUseCases   String[]
  languages          String[]
  /// Per-dimension scoring weights; deterministic calculation reads these.
  scoringWeights     Json?
  status             TargetProfileStatus @default(DRAFT)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  organisation Organisation      @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  accounts     GrowthAccount[]
  playbooks    OutreachPlaybook[]
  imports      GrowthImport[]

  @@unique([organisationId, name])
  @@index([organisationId, status])
}

/// A prospect company. Deliberately separate from Customer: prospects are
/// pre-relationship records; on conversion the account links to the created
/// Customer (customerId) so history and identity carry forward without
/// polluting the operational customer base.
model GrowthAccount {
  id               String              @id @default(cuid())
  organisationId   String
  targetProfileId  String?
  name             String
  nameNormalized   String
  tradingName      String?
  domain           String?
  /// Normalized dedupe key; unique per organisation (NULLs permitted).
  domainNormalized String?
  website          String?
  industry         String?
  country          String?
  region           String?
  city             String?
  employeeEstimate Int?
  description      String?
  phone            String?
  publicEmail      String?
  status           GrowthAccountStatus @default(IMPORTED)
  /// Plain membership/customer references in G1; promoted to relations when
  /// the G2/G4 UI needs includes (documented ADR decision).
  ownerMembershipId String?
  customerId        String?
  lastResearchedAt  DateTime?
  suppressedAt      DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  organisation  Organisation          @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  targetProfile TargetProfile?        @relation(fields: [targetProfileId], references: [id], onDelete: SetNull)
  contacts      GrowthContact[]
  sources       AccountSourceRecord[]
  researchRuns  ResearchRun[]
  evidence      ResearchEvidence[]
  score         AccountScore?
  briefs        AccountBrief[]
  drafts        OutreachDraft[]
  activities    Activity[]
  tasks         Task[]

  @@unique([organisationId, domainNormalized])
  @@index([organisationId, status])
  @@index([organisationId, nameNormalized])
}

/// A person at a prospect company. Personal data under GDPR from the first
/// row: provenance, purpose and verification are recorded; erasure redacts
/// in place; suppression survives erasure as a minimal objection record.
model GrowthContact {
  id                 String    @id @default(cuid())
  organisationId     String
  accountId          String
  firstName          String?
  lastName           String?
  role               String?
  seniority          String?
  department         String?
  email              String?
  emailNormalized    String?
  phone              String?
  language           String?
  profileUrl         String?
  source             String?
  collectedAt        DateTime  @default(now())
  purpose            String    @default("b2b_prospecting")
  verificationStatus String    @default("unverified")
  confidence         Float?
  suppressedAt       DateTime?
  /// Set when PII was removed by erasure or the retention sweep.
  redactedAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  organisation Organisation  @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  account      GrowthAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([organisationId, accountId, emailNormalized])
  @@index([organisationId, accountId])
}

/// Provenance for every imported/discovered account row.
model AccountSourceRecord {
  id                   String    @id @default(cuid())
  organisationId       String
  accountId            String
  provider             String
  providerRecordId     String?
  sourceUrl            String?
  importBatchId        String?
  rawPayload           Json?
  payloadRedactedAt    DateTime?
  duplicateOfAccountId String?
  importedAt           DateTime  @default(now())

  organisation Organisation  @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  account      GrowthAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([organisationId, provider, providerRecordId])
  @@index([organisationId, accountId])
}

/// One research execution against one account (provider-adapter boundary).
model ResearchRun {
  id                     String            @id @default(cuid())
  organisationId         String
  accountId              String
  provider               String
  status                 ResearchRunStatus @default(PENDING)
  requestedByMembershipId String?
  startedAt              DateTime?
  completedAt            DateTime?
  error                  String?
  costCents              Int?
  createdAt              DateTime          @default(now())

  organisation Organisation       @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  account      GrowthAccount      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  evidence     ResearchEvidence[]

  @@index([organisationId, accountId])
}

/// One claim with provenance. The AI must never convert an INFERENCE into a
/// VERIFIED_FACT; classification is part of the record, not presentation.
model ResearchEvidence {
  id             String                 @id @default(cuid())
  organisationId String
  accountId      String
  researchRunId  String?
  category       String
  claim          String
  classification EvidenceClassification
  sourceType     String
  sourceUrl      String?
  sourceTitle    String?
  excerpt        String?
  confidence     Float
  provider       String?
  capturedAt     DateTime               @default(now())
  redactedAt     DateTime?

  organisation Organisation  @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  account      GrowthAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  researchRun  ResearchRun?  @relation(fields: [researchRunId], references: [id], onDelete: SetNull)

  @@index([organisationId, accountId])
}

/// Current score per account; AI recommendation and human adjustment are
/// separate fields, and overrides are audited. History lives in the audit
/// trail, not in row proliferation.
model AccountScore {
  id                     String   @id @default(cuid())
  organisationId         String
  accountId              String   @unique
  aiScore                Int?
  aiComponents           Json?
  aiExplanation          String?
  aiModel                String?
  aiPromptVersion        String?
  humanScore             Int?
  humanReason            String?
  adjustedByMembershipId String?
  confidence             Float?
  missingData            String[]
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  organisation Organisation  @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  account      GrowthAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([organisationId])
}

/// Structured, versioned account brief; every material statement cites
/// evidence ids or is marked inference/hypothesis inside sections JSON.
model AccountBrief {
  id               String   @id @default(cuid())
  organisationId   String
  accountId        String
  version          Int      @default(1)
  sections         Json
  evidenceIds      String[]
  generatedByModel String?
  promptVersion    String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  organisation Organisation  @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  account      GrowthAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([organisationId, accountId, version])
}

/// Approved outreach content boundaries. Drafts may only use approved
/// claims; prohibited claims are validator-enforced, not prompt-enforced.
model OutreachPlaybook {
  id                String   @id @default(cuid())
  organisationId    String
  targetProfileId   String?
  name              String
  language          String
  channel           String   @default("email")
  valuePropositions String[]
  approvedClaims    String[]
  prohibitedClaims  String[]
  tone              String?
  callToAction      String?
  lengthGuidance    String?
  requiredFooter    String?
  requiresApproval  Boolean  @default(true)
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  organisation  Organisation   @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  targetProfile TargetProfile? @relation(fields: [targetProfileId], references: [id], onDelete: SetNull)
  drafts        OutreachDraft[]

  @@unique([organisationId, name])
}

/// An outreach draft. Release 1 terminal states are APPROVED (copy out by a
/// human) and MANUALLY_SENT (the human records the fact). There is no
/// delivery path of any kind in this domain until G6 is authorised.
model OutreachDraft {
  id                     String            @id @default(cuid())
  organisationId         String
  accountId              String
  contactId              String?
  playbookId             String
  language               String
  subject                String
  body                   String
  callToAction           String?
  evidenceIds            String[]
  promptVersion          String?
  model                  String?
  status                 GrowthDraftStatus @default(DRAFT)
  createdByMembershipId  String?
  approvedByMembershipId String?
  decidedAt              DateTime?
  decisionReason         String?
  manuallySentAt         DateTime?
  manualChannel          String?
  externalMessageRef     String?
  redactedAt             DateTime?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  organisation Organisation          @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  account      GrowthAccount         @relation(fields: [accountId], references: [id], onDelete: Cascade)
  playbook     OutreachPlaybook      @relation(fields: [playbookId], references: [id], onDelete: Restrict)
  versions     OutreachDraftVersion[]

  @@index([organisationId, accountId])
  @@index([organisationId, status])
}

model OutreachDraftVersion {
  id                   String   @id @default(cuid())
  organisationId       String
  draftId              String
  version              Int
  subject              String
  body                 String
  editedByMembershipId String?
  createdAt            DateTime @default(now())

  organisation Organisation  @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  draft        OutreachDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)

  @@unique([draftId, version])
}

/// Do-not-contact record. Overrides ALL campaign logic, survives erasure as
/// a minimal objection record, and is enforced at every future send path.
model SuppressionEntry {
  id                    String   @id @default(cuid())
  organisationId        String
  emailNormalized       String?
  domainNormalized      String?
  accountId             String?
  contactId             String?
  reason                String
  source                String
  createdByMembershipId String?
  createdAt             DateTime @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@unique([organisationId, emailNormalized])
  @@index([organisationId, domainNormalized])
}


enum GrowthImportStatus {
  PREVIEWED
  COMMITTING
  COMMITTED
  FAILED
}

/// One CSV import operation (G2). Deliberately stateless about content:
/// the raw file is never persisted — preview and commit each re-receive the
/// text and re-parse deterministically, so retention of raw rows is moot.
/// The report JSON holds row numbers, error codes and duplicate reason
/// codes only — never row content.
model GrowthImport {
  id                    String             @id @default(cuid())
  organisationId        String
  createdByMembershipId String?
  /// Bound at preview; commit uses THIS value, never a client field.
  targetProfileId       String?
  filename              String
  checksum              String
  delimiter             String
  columnMapping         Json
  status                GrowthImportStatus @default(PREVIEWED)
  rowCount              Int                @default(0)
  acceptedCount         Int                @default(0)
  rejectedCount         Int                @default(0)
  duplicateCount        Int                @default(0)
  suppressedCount       Int                @default(0)
  report                Json?
  createdAt             DateTime           @default(now())
  completedAt           DateTime?

  organisation  Organisation   @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  targetProfile TargetProfile? @relation(fields: [targetProfileId], references: [id], onDelete: SetNull)

  @@index([organisationId, createdAt])
}

// ── CRM module (OI-3; engine packages under packages/crm-*) ─────────
// The general commercial pipeline reserved by product decision 10: a Lead is
// the sales PURSUIT work item about a counterpart — not the person (Customer)
// and not the Pronatona Opportunity projection. Business language:
// CRIMSS repo docs/OPERANTO_CANONICAL_DOMAIN_MODEL.md.

enum LeadStatus {
  NEW
  CONTACTED
  NO_ANSWER_1
  NO_ANSWER_2
  NO_ANSWER_3
  RETRY_LATER
  CALLBACK
  APPOINTMENT
  QUALIFIED
  CONVERTED
  REJECTED
  LOST
  WRONG_NUMBER
  UNAVAILABLE
  DO_NOT_CONTACT
}

enum LeadPhoneStatus {
  MISSING
  VALID
  POSSIBLE
  INVALID
}

model Lead {
  id             String     @id @default(cuid())
  organisationId String
  /// The person this pursuit is about, once resolved via the identity ladder.
  /// Nullable: intake precedes identity. Contact fields below are WORKING
  /// COPIES for the sales workflow (dialing), never a second identity model.
  customerId     String?

  fullName          String
  firstName         String?
  lastName          String?
  companyName       String?
  phone             String?
  phoneNormalized   String? // E.164 matching/dialing key (crm-phone)
  phoneCountry      String?
  phoneNational     String?
  phoneExtension    String?
  phoneStatus       LeadPhoneStatus @default(MISSING)
  secondaryPhone    String?
  email             String?
  emailNormalized   String?

  /// Provenance — never lost (canonical intake rule).
  origin            String // manual | import | contact_request | growth_handoff
  source            String?
  externalReference String?
  dataOrigin        String?

  estimatedValue Decimal? @db.Decimal(12, 2)
  currency       String   @default("EUR")

  status          LeadStatus @default(NEW)
  rejectionReason String?
  convertedAt     DateTime?
  lostAt          DateTime?
  archivedAt      DateTime?

  assignedMembershipId  String?
  createdByMembershipId String?

  /// DERIVED scheduling fields — recomputed by syncLeadActionFields inside
  /// every transaction that touches this lead's tasks; never set ad hoc.
  lastActivityAt DateTime?
  nextActionAt   DateTime?
  callbackAt     DateTime?

  /// Do-not-contact workflow flag; enforced at every outbound entry point.
  doNotCall Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organisation  Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  customer      Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  assignee      Membership?  @relation("LeadAssignee", fields: [assignedMembershipId], references: [id], onDelete: SetNull)
  createdBy     Membership?  @relation("LeadCreator", fields: [createdByMembershipId], references: [id], onDelete: SetNull)
  statusHistory LeadStatusHistory[]
  activities    Activity[]
  tasks         Task[]

  @@index([organisationId, status])
  @@index([organisationId, assignedMembershipId])
  @@index([organisationId, phoneNormalized])
  @@index([organisationId, emailNormalized])
  @@index([organisationId, nextActionAt])
  @@index([customerId])
}

/// Append-only status trail (one row per transition; null previousStatus on
/// creation). No update/delete path exists anywhere in the application.
model LeadStatusHistory {
  id                    String     @id @default(cuid())
  organisationId        String
  leadId                String
  previousStatus        LeadStatus?
  newStatus             LeadStatus
  changedByMembershipId String?
  reason                String?
  createdAt             DateTime   @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  lead         Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  changedBy    Membership?  @relation("LeadStatusChanger", fields: [changedByMembershipId], references: [id], onDelete: SetNull)

  @@index([leadId, createdAt])
}

/// Per-organisation telephony (phone-system) connection — provider-neutral
/// settings storage (OI voice slice 1). Credentials are encrypted at rest
/// with OPERANTO_ENCRYPTION_KEY and never returned to the UI or written to
/// audit metadata. Which fields a provider needs is defined in
/// src/lib/telephony-providers.ts; call/webhook behavior arrives with the
/// provider adapter (packages/crm-voice contracts).
model TelephonyConnection {
  id             String @id @default(cuid())
  organisationId String
  /// Catalog id from telephony-providers.ts (e.g. "cloudtalk", "twilio").
  provider       String
  displayName    String
  /// Non-secret provider account/tenant reference (e.g. Twilio Account SID).
  accountRef     String?
  apiKeyEncrypted    String?
  apiSecretEncrypted String?
  /// Signing secret WE generate for the provider's webhook configuration;
  /// shown once at connect time, verified by the future webhook route.
  webhookSecretEncrypted String?
  status ChannelConnectionStatus @default(ACTIVE)
  /// Stage gates, both default OFF (connect → verify → inbound → outbound).
  inboundEnabled  Boolean @default(false)
  outboundEnabled Boolean @default(false)
  lastVerifiedAt DateTime?
  lastEventAt    DateTime?
  lastError      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@unique([organisationId, provider, displayName])
  @@index([organisationId])
}
